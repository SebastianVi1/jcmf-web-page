---
import type { Project } from '../data/projects';
import type { Locale } from '../i18n/routes';
import { t } from '../i18n';
import { getProjectPhoto } from '../lib/project-media';
import Architecture from './Architecture.astro';
import ProjectPhoto from './ProjectPhoto';
interface Props {
  project: Project;
  locale: Locale;
  priority?: boolean;
}
const { project, locale, priority = false } = Astro.props;
const photo = await getProjectPhoto(project, priority);
---

{photo ? (
  <ProjectPhoto
    client:visible
    {...photo}
    alt={project.content[locale].imageAlt || project.content[locale].title}
    errorLabel={t(locale).ui.imageError}
  />
) : (
  <Architecture variant={project.visual} />
)}
