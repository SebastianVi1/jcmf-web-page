---
interface Props {
  variant?: 'tower' | 'hall' | 'bridge';
  hero?: boolean;
}
const { variant = 'tower', hero = false } = Astro.props;
const uid = 'arch-' + Math.random().toString(36).slice(2, 10);
---

<div
  class:list={[
    'architecture',
    'architecture-' + variant,
    { 'architecture-hero': hero },
  ]}
  aria-hidden="true"
>
  <svg viewBox="0 0 720 670" fill="none" focusable="false">
    <defs>
      <linearGradient
        id={uid + '-front'}
        x1="220"
        y1="160"
        x2="510"
        y2="590"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#e1e5e5" />
        <stop offset="1" stop-color="#a7b0b6" />
      </linearGradient>
      <linearGradient
        id={uid + '-side'}
        x1="430"
        y1="200"
        x2="625"
        y2="450"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#6e7e8e" />
        <stop offset="1" stop-color="#a6b1b9" />
      </linearGradient>
      <linearGradient
        id={uid + '-glass'}
        x1="200"
        y1="180"
        x2="510"
        y2="590"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#445b71" />
        <stop offset="1" stop-color="#182d43" />
      </linearGradient>
      <pattern
        id={uid + '-grid'}
        width="50"
        height="50"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M50 0H0v50"
          stroke="currentColor"
          stroke-opacity=".07"
          stroke-width=".6"
        />
      </pattern>
    </defs>
    <path
      d="M80 530 365 366 689 551 402 716Z"
      fill="currentColor"
      opacity=".035"
    />
    <path
      d="m24 526 337-195 351 202M90 601l336-194M184 655l334-194M117 419l351 203M220 359l351 203"
      stroke="currentColor"
      stroke-opacity=".13"
      stroke-width=".6"
    />
    {variant === 'tower' && (
      <>
        <g class="model-back">
          <path d="m379 131 111-63 102 60-111 63Z" fill="#eef0ee" />
          <path d="M379 131v330l102 60V191Z" fill={'url(#' + uid + '-front)'} />
          <path
            d="m481 191 111-63v330l-111 63Z"
            fill={'url(#' + uid + '-side)'}
          />
          {Array.from({ length: 10 }, (_, i) => (
            <path
              d={'m389 ' + (156 + i * 29) + ' 82 47v12l-82-47Z'}
              fill="#70818e"
              opacity=".7"
            />
          ))}
          {Array.from({ length: 10 }, (_, i) => (
            <path
              d={'m490 ' + (209 + i * 29) + ' 92-53v12l-92 53Z'}
              fill="#314a62"
              opacity=".8"
            />
          ))}
        </g>
        <g class="model-main">
          <path d="m183 225 175-101 155 90-175 101Z" fill="#e9edeb" />
          <path d="M183 225v307l155 90V315Z" fill={'url(#' + uid + '-front)'} />
          <path
            d="m338 315 175-101v307L338 622Z"
            fill={'url(#' + uid + '-glass)'}
          />
          {Array.from({ length: 9 }, (_, i) => (
            <g>
              <path
                d={'m194 ' + (252 + i * 31) + ' 132 76v15l-132-76Z'}
                fill="#85949e"
                opacity=".65"
              />
              <path
                d={
                  'm338 ' +
                  (339 + i * 31) +
                  ' 175-101v7L338 ' +
                  (346 + i * 31) +
                  'Z'
                }
                fill="#b9c3c8"
              />
            </g>
          ))}
          {Array.from({ length: 7 }, (_, i) => (
            <path
              d={'M' + (355 + i * 23) + ' ' + (305 - i * 13.28) + 'v294'}
              stroke="#afbbc4"
              stroke-width="3"
            />
          ))}
          <path
            d="M183 225v307l155 90V315Z"
            stroke="#eff1ef"
            stroke-opacity=".4"
          />
          <path
            d="m181 220 177-102 158 92v14L338 327l-157-91Z"
            fill="#d4dbdc"
          />
          <path d="m181 220 157 91 178-101-158-92Z" fill="#eef1ed" />
          <path d="m235 221 122-70 103 59-122 71Z" fill="#7d8d99" />
          <path d="m252 221 105-61 86 50-105 61Z" fill="#b6c0c2" />
          <path
            d="m179 525 159 93 177-103v17L338 635l-159-93Z"
            fill="#85939d"
          />
        </g>
        <g class="model-accent">
          <path d="m108 431 133-77 83 48-133 77Z" fill="#507ae0" />
          <path d="M108 431v106l83 48V479Z" fill="#244fc0" />
          <path d="m191 479 133-77v106l-133 77Z" fill="#183978" />
          {Array.from({ length: 5 }, (_, i) => (
            <path
              d={'m' + (204 + i * 23) + ' ' + (481 - i * 13.2) + 'v80'}
              stroke="#91acde"
              stroke-width="4"
            />
          ))}
          <path d="m108 431 83 48 133-77" stroke="#93afe5" stroke-width="2" />
        </g>
        <path
          class="model-guide"
          d="M357 41v62m-12-48h24M634 126v379m-6-375h12m-12 370h12M128 240v-90h142"
          stroke="currentColor"
          stroke-opacity=".28"
          stroke-width="1"
          stroke-dasharray="3 5"
        />
      </>
    )}
    {variant === 'hall' && (
      <g class="model-main">
        <path d="m96 340 324-187 229 133-324 187Z" fill="#e5e9e7" />
        <path d="M96 340v186l229 133V473Z" fill={'url(#' + uid + '-front)'} />
        <path
          d="m325 473 324-187v186L325 659Z"
          fill={'url(#' + uid + '-side)'}
        />
        {Array.from({ length: 7 }, (_, i) => (
          <g>
            <path
              d={'m' + (121 + i * 44) + ' ' + (326 - i * 25.4) + ' 226 131'}
              stroke="#a5b2ba"
              stroke-width="7"
            />
            <path
              d={'M' + (347 + i * 44) + ' ' + (463 - i * 25.4) + 'v161'}
              stroke="#e2e7e6"
              stroke-width="9"
            />
          </g>
        ))}
        <path d="m126 393 157 91v111l-157-91Z" fill="#294363" />
        <path d="m126 393 157 91v17l-157-91Z" fill="#3c6cd8" />
        <path
          d="m370 475 85-49v124l-85 49Zm127-74 84-48v124l-84 49Z"
          fill="#344e63"
        />
      </g>
    )}
    {variant === 'bridge' && (
      <g class="model-main">
        <path d="m76 417 439-253 111 65-439 253Z" fill="#dce1df" />
        <path d="m76 417 111 65v26L76 443Z" fill="#8698a3" />
        <path d="m187 482 439-253v26L187 508Z" fill="#5d748a" />
        <path
          d="m217 464 33-19v116l-33 19-35-20V445Zm236-137 33-19v117l-33 19-35-20V307Z"
          fill="#aebbc1"
        />
        <path d="m184 373 307-177v14L184 387Z" fill="#315ebd" />
        <path
          d="m103 419 439-253M166 460l440-254"
          stroke="#f5f5ed"
          stroke-width="4"
        />
        {Array.from({ length: 12 }, (_, i) => (
          <path
            d={'m' + (158 + i * 35) + ' ' + (445 - i * 20) + ' 19-11'}
            stroke="#f5f5ed"
            stroke-width="2"
          />
        ))}
        {Array.from({ length: 10 }, (_, i) => (
          <path
            d={'M' + (202 + i * 32) + ' ' + (469 - i * 18.5) + 'v-66'}
            stroke="#6683b4"
            stroke-width="3"
          />
        ))}
      </g>
    )}
  </svg>
</div>
