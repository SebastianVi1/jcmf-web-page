---
import { t } from '../i18n';
import type { Locale } from '../i18n/routes';
import Icon from './Icon.astro';
import ConstructionIsland from '../features/construction/ConstructionIsland';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<section
  class="construction-hero construction-projects"
  aria-labelledby="construction-title"
  data-construction
>
  <div class="container construction-intro">
    <div>
      <h2 id="construction-title">{copy.projects.constructionTitle}</h2>
      <p>{copy.projects.constructionIntro}</p>
    </div>
  </div>
  <div class="construction-stage">
    <div class="construction-visual">
      <img
        class="construction-poster construction-poster-complete"
        src="/images/construction/complete.webp"
        width="1200"
        height="1200"
        alt=""
        fetchpriority="high"
      />
      <img
        class="construction-poster construction-poster-start"
        src="/images/construction/start.webp"
        width="1200"
        height="1200"
        alt=""
      />
      <ConstructionIsland client:load copy={copy.home.construction} />
    </div>
    <div class="construction-footer">
      <div class="construction-caption">
        <p>{copy.home.construction.caption}</p>
        <p class="construction-phase" data-construction-phase>
          {copy.home.construction.phases[0]}
        </p>
        <span class="construction-progress" aria-hidden="true">
          <span data-construction-meter></span>
        </span>
      </div>
      <a
        class="construction-skip icon-button"
        href="#cta-title"
        aria-label={copy.projects.skipConstruction}
        title={copy.projects.skipConstruction}
        data-construction-skip
      >
        <Icon name="down" size={18} />
      </a>
    </div>
  </div>
</section>
