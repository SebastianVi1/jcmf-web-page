---
import { t } from '../i18n';
import { route, type Locale } from '../i18n/routes';
import { portfolioProjects, type Project } from '../data/projects';
import { getProjectPhoto } from '../lib/project-media';
import ProjectCaseStudy from '../components/ProjectCaseStudy';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import HeroMark from '../components/HeroMark.astro';
import CallToAction from '../components/CallToAction.astro';
interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;
const copy = t(locale);
const content = project.content[locale];
const photo = await getProjectPhoto(project, true);
const mediaLabel =
  project.mediaType === 'photo' ? copy.ui.photo : copy.ui.visualReference;
const related = portfolioProjects
  .filter((item) => item.slug !== project.slug)
  .slice(0, 2);
---

<article class="container project-detail">
  <a class="text-link back-link" href={route(locale, 'projects')}>
    <span aria-hidden="true">←</span>
    {copy.ui.back}
  </a>
  <header class="case-heading">
    <div>
      <p class="eyebrow hero-enter">
        {copy.projects.categories[project.category]}
      </p>
      <h1 class="hero-title-inner">
        <span class="line-mask">
          <span>{content.title}</span>
        </span>
      </h1>
    </div>
    <HeroMark kind="projects" />
  </header>
  {photo ? (
    <ProjectCaseStudy
      client:visible
      title={content.title}
      content={content}
      category={copy.projects.categories[project.category]}
      mediaLabel={mediaLabel}
      photo={{
        ...photo,
        alt: content.imageAlt || content.title,
        errorLabel: copy.ui.imageError,
      }}
      source={project.source}
      scopeProvided={Boolean(project.scopeProvided)}
      copy={copy.projects}
      imageCaption={
        project.mediaType === 'photo'
          ? copy.ui.photoCaption
          : copy.ui.referenceCaption
      }
    />
  ) : (
    <section class="legacy-concept">
      <ProjectMedia project={project} locale={locale} />
      <p class="caption">{copy.ui.demo}</p>
      <h2>{copy.projects.overview}</h2>
      <p>{content.description}</p>
    </section>
  )}
</article>
<section class="section container" aria-labelledby="related-title">
  <div class="section-heading">
    <h2 id="related-title">{copy.projects.moreProjects}</h2>
    <a class="text-link" href={route(locale, 'projects')}>
      {copy.ui.all}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="project-grid related-projects">
    {related.map((item) => (
      <ProjectCard project={item} locale={locale} />
    ))}
  </div>
</section>
<CallToAction locale={locale} />
