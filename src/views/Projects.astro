---
import { t } from '../i18n';
import PageHero from '../components/PageHero.astro';
import type { Locale } from '../i18n/routes';
import { projects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<PageHero
  eyebrow={copy.projects.eyebrow}
  title={copy.projects.title}
  intro={copy.projects.intro}
  kind="projects"
/>
<section
  class="container section-bottom"
  aria-label={copy.nav.projects}
  data-project-gallery
>
  <div class="filter-bar">
    <div class="filters js-only" role="group" aria-label={copy.ui.filter}>
      {Object.entries(copy.projects.categories).map(([key, label]) => (
        <button type="button" data-filter={key} aria-pressed={key === 'all'}>
          {label}
        </button>
      ))}
    </div>
    <p class="caption" aria-live="polite" aria-atomic="true">
      <span data-project-count>{projects.length}</span> {copy.ui.results}
    </p>
  </div>
  <div class="project-grid">
    {projects.map((project) => (
      <ProjectCard project={project} locale={locale} />
    ))}
  </div>
</section>
<CallToAction locale={locale} />
