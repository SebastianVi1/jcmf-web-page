---
import { t } from '../i18n';
import { route, type Locale } from '../i18n/routes';
import Architecture from '../components/Architecture.astro';
import { getProjectPhoto } from '../lib/project-media';
import Icon from '../components/Icon.astro';
import HomeShowcase from '../components/HomeShowcase.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { portfolioProjects as projects } from '../data/projects';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
// Reuse the portfolio source and build-time WebP adapter; the hero is decorative
// and its visible reference caption must remain alongside the marketing copy.
const heroProject = projects[0];
const heroPhoto = await getProjectPhoto(heroProject, true);
---

<section class="masthead" aria-labelledby="hero-title">
  {heroPhoto && (
    <img
      class="masthead-image"
      src={heroPhoto.src}
      srcset={heroPhoto.srcSet}
      sizes="100vw"
      width={heroPhoto.width}
      height={heroPhoto.height}
      alt=""
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  )}
  <div class="masthead-content container">
    <p class="eyebrow hero-enter">{copy.home.eyebrow}</p>
    <h1 id="hero-title" class="hero-title">
      {copy.home.title.map((line, i) => (
        <span class="line-mask">
          <span style={'--line-delay:' + i * 130 + 'ms'}>{line}</span>
        </span>
      ))}
    </h1>
    <div class="masthead-footer hero-enter">
      <div>
        <p class="masthead-description">{copy.home.intro}</p>
        <div class="masthead-actions">
          <a class="button masthead-primary" href={route(locale, 'projects')}>
            {copy.home.primary}
            <Icon name="diagonal" size={20} />
          </a>
          <a class="text-link" href={route(locale, 'contact')}>
            {copy.nav.contact}
            <Icon name="diagonal" size={18} />
          </a>
        </div>
      </div>
      <p class="masthead-caption">
        {copy.ui.photo}
        <br />
        {heroProject.content[locale].title}
      </p>
    </div>
  </div>
</section>
<div class="hero-bottom container">
  <a class="scroll-link" href="#capacidades">
    <span class="scroll-icon">
      <Icon name="down" size={16} />
    </span>
    {copy.ui.scroll}
  </a>
  <a href={route(locale, 'about')} class="text-link">
    {copy.home.secondary}
    <Icon name="diagonal" size={16} />
  </a>
</div>
<div class="sector-strip">
  <div class="container">
    {copy.home.sectors.map((sector) => (
      <span>
        {sector}
        <span class="sector-dot" aria-hidden="true"></span>
      </span>
    ))}
  </div>
</div>
<section
  class="section container about-preview"
  aria-labelledby="about-heading"
>
  <div data-reveal>
    <p class="eyebrow">{copy.home.aboutEyebrow}</p>
    <h2 id="about-heading" class="multiline">
      {copy.home.aboutTitle}
    </h2>
    <a class="text-link" href={route(locale, 'about')}>
      {copy.home.aboutLink}
      <Icon name="diagonal" size={18} />
    </a>
    <figure class="home-study">
      <Architecture hero />
      <figcaption>
        {copy.home.visualNote} · {copy.ui.demo}
      </figcaption>
    </figure>
  </div>
  <div data-reveal>
    <p class="large-copy">{copy.home.aboutText}</p>
    <dl class="principles">
      {copy.home.principles.map(([name, desc]) => (
        <div>
          <dt>{name}</dt>
          <dd>{desc}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<section
  class="section services-section"
  id="capacidades"
  aria-labelledby="services-title"
>
  <div class="container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">{copy.home.servicesEyebrow}</p>
        <h2 id="services-title" class="multiline">
          {copy.home.servicesTitle}
        </h2>
      </div>
      <p>{copy.home.servicesIntro}</p>
    </div>
    <div class="services-grid">
      {copy.home.services.map(([title, desc, icon]) => (
        <article class="service-card" data-reveal="line">
          <span class="service-icon">
            <Icon name={icon} size={30} />
          </span>
          <h3>{title}</h3>
          <p>{desc}</p>
          <a
            class="service-link"
            href={route(locale, 'contact')}
            aria-label={copy.nav.contact + ': ' + title}
          >
            <Icon name="diagonal" size={23} />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
<section class="section container" aria-labelledby="projects-title">
  <div class="section-heading" data-reveal>
    <div>
      <p class="eyebrow">{copy.home.projectsEyebrow}</p>
      <h2 id="projects-title" class="multiline">
        {copy.home.projectsTitle}
      </h2>
    </div>
    <a class="text-link" href={route(locale, 'projects')}>
      {copy.ui.all}
      <Icon name="diagonal" size={18} />
    </a>
  </div>
  <div class="project-grid home-projects">
    {projects.slice(0, 2).map((project) => (
      <ProjectCard project={project} locale={locale} />
    ))}
  </div>
  <p class="caption portfolio-note">{copy.home.projectsNote}</p>
</section>
<HomeShowcase locale={locale} />
<section class="section process-section" aria-labelledby="process-title">
  <div class="container">
    <p class="eyebrow" data-reveal>
      {copy.home.processEyebrow}
    </p>
    <h2 id="process-title" data-reveal>
      {copy.home.processTitle}
    </h2>
    <ol class="process-grid">
      {copy.home.process.map(([title, desc], i) => (
        <li data-reveal="line" style={'--reveal-delay:' + i * 70 + 'ms'}>
          <span class="process-number">0{i + 1}</span>
          <h3>{title}</h3>
          <p>{desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<CallToAction locale={locale} />
