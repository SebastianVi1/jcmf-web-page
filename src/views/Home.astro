---
import { t } from '../i18n';
import { route, type Locale } from '../i18n/routes';
import Architecture from '../components/Architecture.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { projects } from '../data/projects';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow hero-enter">
      <span class="status-dot"></span>
      {copy.home.eyebrow}
    </p>
    <h1 id="hero-title" class="hero-title hero-enter">
      {copy.home.title.map((line, i) => (
        <span class:list={[{ 'accent-word': i === 2 }]}>{line}</span>
      ))}
    </h1>
    <p class="hero-description hero-enter">{copy.home.intro}</p>
    <div class="hero-buttons hero-enter">
      <a class="button" href={route(locale, 'projects')}>
        {copy.home.primary}
        <Icon name="diagonal" size={18} />
      </a>
      <a class="text-link" href={route(locale, 'about')}>
        {copy.home.secondary}
        <Icon size={18} />
      </a>
    </div>
  </div>
  <figure class="hero-visual">
    <div class="visual-topline">
      <span>{copy.home.visualLabel}</span>
      <Icon name="plus" size={14} />
    </div>
    <Architecture hero />
    <figcaption>
      <span>{copy.home.visualNote}</span>
      <span>{locale === 'es' ? 'CONCEPTO / 001' : 'CONCEPT / 001'}</span>
    </figcaption>
  </figure>
  <div class="hero-bottom">
    <a href="#capacidades" class="scroll-link">
      <span class="scroll-icon">
        <Icon name="down" size={15} />
      </span>
      {copy.ui.scroll}
    </a>
    <span class="hero-bottom-note">
      {locale === 'es' ? 'PRECISIÓN EN CADA ETAPA' : 'PRECISION AT EVERY STAGE'}
    </span>
  </div>
</section>
<div class="sector-strip">
  <div class="container">
    {copy.home.sectors.map((sector) => (
      <span>
        {sector}
        <Icon name="plus" size={15} />
      </span>
    ))}
  </div>
</div>
<section
  class="section container about-preview"
  aria-labelledby="about-heading"
>
  <div data-reveal>
    <p class="eyebrow">{copy.home.aboutEyebrow}</p>
    <h2 id="about-heading" class="multiline">
      {copy.home.aboutTitle}
    </h2>
    <a class="text-link" href={route(locale, 'about')}>
      {copy.home.aboutLink}
      <Icon name="diagonal" size={18} />
    </a>
  </div>
  <div data-reveal>
    <p class="large-copy">{copy.home.aboutText}</p>
    <dl class="principles">
      {copy.home.principles.map(([name, desc]) => (
        <div>
          <dt>{name}</dt>
          <dd>{desc}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<section
  class="section services-section"
  id="capacidades"
  aria-labelledby="services-title"
>
  <div class="container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">{copy.home.servicesEyebrow}</p>
        <h2 id="services-title" class="multiline">
          {copy.home.servicesTitle}
        </h2>
      </div>
      <p>{copy.home.servicesIntro}</p>
    </div>
    <div class="services-grid">
      {copy.home.services.map(([title, desc, icon]) => (
        <article class="service-card" data-reveal>
          <span class="service-icon">
            <Icon name={icon} size={35} />
          </span>
          <h3>{title}</h3>
          <p>{desc}</p>
          <a
            class="service-link"
            href={route(locale, 'contact')}
            aria-label={copy.nav.contact + ': ' + title}
          >
            <Icon name="diagonal" size={23} />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
<section class="section container" aria-labelledby="projects-title">
  <div class="section-heading" data-reveal>
    <div>
      <p class="eyebrow">{copy.home.projectsEyebrow}</p>
      <h2 id="projects-title" class="multiline">
        {copy.home.projectsTitle}
      </h2>
    </div>
    <a class="text-link" href={route(locale, 'projects')}>
      {copy.ui.all}
      <Icon name="diagonal" size={18} />
    </a>
  </div>
  <div class="project-grid home-projects">
    {projects.slice(0, 2).map((project) => (
      <ProjectCard project={project} locale={locale} />
    ))}
  </div>
  <p class="caption portfolio-note">{copy.home.projectsNote}</p>
</section>
<section class="section process-section" aria-labelledby="process-title">
  <div class="container">
    <p class="eyebrow" data-reveal>
      {copy.home.processEyebrow}
    </p>
    <h2 id="process-title" data-reveal>
      {copy.home.processTitle}
    </h2>
    <ol class="process-grid">
      {copy.home.process.map(([title, desc], i) => (
        <li data-reveal>
          <span class="process-number">0{i + 1}</span>
          <h3>{title}</h3>
          <p>{desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<CallToAction locale={locale} />
