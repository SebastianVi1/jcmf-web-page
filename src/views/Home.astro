---
import { t } from '../i18n';
import { route, type Locale } from '../i18n/routes';
import Architecture from '../components/Architecture.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { portfolioProjects as projects } from '../data/projects';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-kicker hero-enter">
    <p class="eyebrow">
      <span class="status-dot"></span>
      {copy.home.eyebrow}
    </p>
    <span>{copy.home.visualLabel}</span>
  </div>
  <div class="hero-heading-row">
    <h1 id="hero-title" class="hero-title">
      {copy.home.title.map((line, i) => (
        <span class:list={['line-mask', { 'accent-word': i === 1 }]}>
          <span style={'--line-delay:' + i * 130 + 'ms'}>{line}</span>
        </span>
      ))}
    </h1>
    <div class="hero-summary hero-enter">
      <p class="hero-description">{copy.home.intro}</p>
      <a class="text-link" href={route(locale, 'projects')}>
        {copy.home.primary}
        <Icon name="diagonal" size={19} />
      </a>
    </div>
  </div>
  <div class="hero-showcase">
    <figure class="hero-real-photo hero-enter">
      <a href={route(locale, 'projects')} aria-label={copy.home.primary}>
        <ProjectMedia project={projects[0]} locale={locale} priority />
      </a>
      <figcaption>
        <span>{projects[0].content[locale].title}</span>
        <span>{copy.ui.photo}</span>
      </figcaption>
    </figure>
    <figure class="hero-visual hero-structure">
      <Architecture hero />
      <figcaption>
        <span>{copy.home.visualNote}</span>
        <span>{copy.ui.demo}</span>
      </figcaption>
    </figure>
  </div>
  <div class="hero-bottom">
    <a class="scroll-link" href="#capacidades">
      <span class="scroll-icon">
        <Icon name="down" size={16} />
      </span>
      {copy.ui.scroll}
    </a>
    <a href={route(locale, 'about')} class="text-link">
      {copy.home.secondary}
      <Icon name="diagonal" size={16} />
    </a>
  </div>
</section>
<div class="sector-strip">
  <div class="container">
    {copy.home.sectors.map((sector) => (
      <span>
        {sector}
        <span class="sector-dot" aria-hidden="true"></span>
      </span>
    ))}
  </div>
</div>
<section
  class="section container about-preview"
  aria-labelledby="about-heading"
>
  <div data-reveal>
    <p class="eyebrow">{copy.home.aboutEyebrow}</p>
    <h2 id="about-heading" class="multiline">
      {copy.home.aboutTitle}
    </h2>
    <a class="text-link" href={route(locale, 'about')}>
      {copy.home.aboutLink}
      <Icon name="diagonal" size={18} />
    </a>
  </div>
  <div data-reveal>
    <p class="large-copy">{copy.home.aboutText}</p>
    <dl class="principles">
      {copy.home.principles.map(([name, desc]) => (
        <div>
          <dt>{name}</dt>
          <dd>{desc}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<section
  class="section services-section"
  id="capacidades"
  aria-labelledby="services-title"
>
  <div class="container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">{copy.home.servicesEyebrow}</p>
        <h2 id="services-title" class="multiline">
          {copy.home.servicesTitle}
        </h2>
      </div>
      <p>{copy.home.servicesIntro}</p>
    </div>
    <div class="services-grid">
      {copy.home.services.map(([title, desc, icon]) => (
        <article class="service-card" data-reveal="line">
          <span class="service-icon">
            <Icon name={icon} size={30} />
          </span>
          <h3>{title}</h3>
          <p>{desc}</p>
          <a
            class="service-link"
            href={route(locale, 'contact')}
            aria-label={copy.nav.contact + ': ' + title}
          >
            <Icon name="diagonal" size={23} />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
<section class="section container" aria-labelledby="projects-title">
  <div class="section-heading" data-reveal>
    <div>
      <p class="eyebrow">{copy.home.projectsEyebrow}</p>
      <h2 id="projects-title" class="multiline">
        {copy.home.projectsTitle}
      </h2>
    </div>
    <a class="text-link" href={route(locale, 'projects')}>
      {copy.ui.all}
      <Icon name="diagonal" size={18} />
    </a>
  </div>
  <div class="project-grid home-projects">
    {projects.slice(0, 2).map((project) => (
      <ProjectCard project={project} locale={locale} />
    ))}
  </div>
  <p class="caption portfolio-note">{copy.home.projectsNote}</p>
</section>
<section class="section process-section" aria-labelledby="process-title">
  <div class="container">
    <p class="eyebrow" data-reveal>
      {copy.home.processEyebrow}
    </p>
    <h2 id="process-title" data-reveal>
      {copy.home.processTitle}
    </h2>
    <ol class="process-grid">
      {copy.home.process.map(([title, desc], i) => (
        <li data-reveal="line" style={'--reveal-delay:' + i * 70 + 'ms'}>
          <span class="process-number">0{i + 1}</span>
          <h3>{title}</h3>
          <p>{desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<CallToAction locale={locale} />
