---
import { t } from '../i18n';
import type { Locale } from '../i18n/routes';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
---

<section class="container page-intro">
  <p class="eyebrow">{copy.privacy.eyebrow}</p>
  <h1 class="multiline">{copy.privacy.title}</h1>
</section>
<div class="container section-bottom">
  <div class="prose">
    {copy.privacy.paragraphs.map((text) => (
      <p>{text}</p>
    ))}
  </div>
</div>
